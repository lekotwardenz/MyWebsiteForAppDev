<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>1080x1300 Canvas</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="style.css">
</head>
<body>
    @page "/"

    <div class="canvas-container">
        <!-- Transparent Pattern Overlay -->
        <div class="pattern-overlay">
            <img src="/images/gradient-pattern.png" alt="Grid Pattern" class="pattern-image" />
        </div>

        <div class="header-section">
            <img src="/images/horizon-background-img.png" alt="Horizon Header" class="top-header-image" />
            <div class="gradient-overlay"></div>
            
            <!-- Navigation Bar -->
            <nav class="navbar">
                <div class="nav-brand">
                    <div class="logo-container">
                        <img src="/images/logo.png" alt="Logo" class="logo-image" />
                    </div>
                    <div class="brand-separator"></div>
                    <span class="brand-title">VIDEO GAMES</span>
                </div>
                <div class="nav-links">
                    <a href="#" class="active">Home</a>
                    <a href="#">Community</a>
                    <a href="#">About us</a>
                </div>
            </nav>

            <!-- Centered Title Card -->
            <div class="title-card-container">
                <img src="/images/horizon-title-card.png" alt="Title Card" class="title-card-image" />
            </div>
        </div>

        <!-- --- Character Showcase Boxes --- -->
        <div class="characters-section">
            <div class="char-box box-1">
                <img src="/images/Box1.png" alt="Gradient Left" />
            </div>
            <div class="char-box box-2">
                <img src="/images/Photo1.png" alt="Undertale" />
            </div>
            <div class="char-box box-3">
                <a href="/spiderman">
                    <img src="/images/Photo2.png" alt="Spider-Man" />
                </a>
            </div>
            <div class="char-box box-4">
                <img src="/images/Photo3.png" alt="Minecraft" />
            </div>
            <div class="char-box box-5">
                <img src="/images/Box2.png" alt="Gradient Right" />
            </div>
        </div>

    </div>
</body>
</html>